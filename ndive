"""
Neural Dive - Cyberpunk Terminal Roguelike

A terminal-based game where you descend through neural layers, answering
computer science questions and battling AI entities.

Quick Start:
  ndive              Play with default settings
  ndive --seed 42    Play a reproducible run
  ndive --load       Resume the saved game
  ndive --help       Show all options
"""

import os
import sys

# Add this file's directory to the path, so `neural_dive` is importable when
# the script is run from anywhere. It has to happen before the import below,
# which is why that import is not at the top of the file.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from neural_dive.__main__ import main  # noqa: E402

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\nGame interrupted. Thanks for playing Neural Dive!")
        sys.exit(0)
    except Exception as e:
        print(f"\n\nError: {e}")
        print("\nIf this is a bug, please report it at:")
        print("https://github.com/qyearsley/neural-dive/issues")
        sys.exit(1)
